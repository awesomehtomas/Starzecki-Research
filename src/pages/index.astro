---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ReportRow from '../components/ReportRow.astro';
import RatingBadge from '../components/RatingBadge.astro';
import StatBlock from '../components/StatBlock.astro';
import NavChart from '../components/NavChart.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { getPortfolio } from '../lib/portfolio';
import { site } from '../data/site';
import { pct, formatDate, formatPrice, impliedMove } from '../lib/format';

const reports = (await getCollection('reports')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);
const featured = reports[0] ?? null;
const rest = reports.slice(1, 4);
const pf = getPortfolio();
const fMove = featured ? impliedMove(featured.data.priceAtPublication, featured.data.priceTarget) : 0;

const pillars = [
  {
    label: 'Research',
    href: '/research',
    linkText: 'Browse reports',
    body: 'In-depth long/short reports, each following the same 12-section format.',
  },
  {
    label: 'Portfolio',
    href: '/portfolio',
    linkText: 'View the book',
    body: 'A hypothetical paper book, marked to market and benchmarked against the S&P 500.',
  },
  {
    label: 'Methodology',
    href: '/methodology',
    linkText: 'How it works',
    body: 'How the work is produced — and why losing calls stay published.',
  },
];
---

<BaseLayout title={site.name} description={site.description}>
  <!-- Front page lead: statement + the record -->
  <section class="border-b border-line">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 py-14 md:py-20 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-16">
      <div>
        <p class="label-caps">Independent equity research</p>
        <h1 class="mt-5 font-serif text-[2.5rem] leading-[1.05] tracking-[-0.015em] text-ink md:text-[3.5rem]">
          Analysis in the open.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">
          Starzecki Research publishes in-depth long/short equity research — every call timestamped at
          publication, benchmarked against the S&amp;P 500, and left on the record whether it works or
          not.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a href="/research" class="btn btn-primary">Read the research</a>
          <a href="/portfolio" class="btn btn-outline">The paper portfolio</a>
        </div>
      </div>

      <aside aria-label="The record so far">
        <StatBlock
          rows={[
            { label: 'Reports published', value: String(reports.length) },
            { label: 'Paper NAV', value: pct(pf.navReturn) },
            {
              label: 'vs S&P 500',
              value: pct(pf.excess),
              color: pf.excess >= 0 ? 'text-long' : 'text-short',
            },
            { label: 'Inception', value: formatDate(new Date(pf.inceptionDate)) },
          ]}
          note="Hypothetical paper book. Price-only, no real capital."
        >
        </StatBlock>
      </aside>
    </div>
  </section>

  <!-- Latest research -->
  <section class="mx-auto max-w-6xl px-5 py-14">
    <div class="flex items-baseline justify-between border-b border-ink pb-3">
      <h2 class="font-serif text-2xl text-ink">Latest research</h2>
      <a href="/research" class="link font-sans text-sm">All reports</a>
    </div>

    {
      featured ? (
        <div class="mt-9 grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-16">
          <article>
            <p class="font-sans text-xs text-muted">
              <time datetime={featured.data.publishDate.toISOString()} class="figure">
                {formatDate(featured.data.publishDate)}
              </time>
              <span class="px-1.5" aria-hidden="true">·</span>
              {featured.data.sector}
            </p>
            <h3 class="mt-3 font-serif text-3xl leading-tight text-ink md:text-4xl">
              <a href={`/research/${featured.id}`} class="transition-colors hover:text-accent">
                {featured.data.title}
              </a>
            </h3>
            <p class="mt-3 font-sans text-sm text-muted">
              <span class="figure font-semibold text-ink">{featured.data.ticker}</span>
              <span class="px-1.5" aria-hidden="true">·</span>{featured.data.company}
            </p>
            <div class="mt-4 flex items-center gap-2.5">
              <RatingBadge rating={featured.data.rating} />
              <span class="font-sans text-sm text-muted">{featured.data.conviction} conviction</span>
            </div>
            <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-soft">{featured.data.summary}</p>
            <a href={`/research/${featured.id}`} class="link mt-6 inline-block font-sans text-sm font-medium">
              Read the report
            </a>
          </article>

          <aside>
            <StatBlock
              ticker={featured.data.ticker}
              company={featured.data.company}
              rating={featured.data.rating}
              rows={[
                { label: 'Entry', value: formatPrice(featured.data.priceAtPublication) },
                { label: 'Target', value: formatPrice(featured.data.priceTarget) },
                {
                  label: 'Implied upside',
                  value: pct(fMove),
                  color: fMove >= 0 ? 'text-long' : 'text-short',
                },
                { label: 'Horizon', value: featured.data.horizon },
              ]}
            />
          </aside>
        </div>
      ) : (
        <div class="mt-9 border border-line bg-card px-6 py-14 text-center">
          <p class="font-serif text-xl text-ink">The first report publishes soon.</p>
          <p class="mx-auto mt-2 max-w-md font-sans text-sm leading-relaxed text-muted">
            When it's live, the latest report will headline here — with its thesis, rating, and price
            target front and center.
          </p>
        </div>
      )
    }
  </section>

  <!-- What you'll find -->
  <section class="mx-auto max-w-6xl px-5 py-4 pb-14">
    <p class="label-caps border-b border-ink pb-3">What you'll find here</p>
    <div>
      {
        pillars.map((p) => (
          <div class="grid gap-x-8 gap-y-1 border-b border-line py-5 sm:grid-cols-[8.5rem_minmax(0,1fr)_auto] sm:items-baseline">
            <h3 class="font-serif text-xl text-ink">{p.label}</h3>
            <p class="max-w-xl text-[0.9375rem] leading-relaxed text-ink-soft">{p.body}</p>
            <a href={p.href} class="link font-sans text-sm">
              {p.linkText}
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <!-- More research -->
  {
    rest.length > 0 && (
      <section class="mx-auto max-w-6xl px-5 pb-14">
        <h2 class="border-b border-ink pb-3 font-serif text-2xl text-ink">More research</h2>
        <div>
          {rest.map((report) => (
            <ReportRow report={report} />
          ))}
        </div>
      </section>
    )
  }

  <!-- Portfolio snapshot -->
  <section class="border-t border-line">
    <div class="mx-auto max-w-6xl px-5 py-14">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-start lg:gap-16">
        <div>
          <p class="label-caps">The paper portfolio</p>
          <h2 class="mt-3 font-serif text-2xl text-ink md:text-3xl">
            Marked to market, benchmarked, on the record.
          </h2>
          <p class="mt-4 max-w-md leading-relaxed text-ink-soft">
            A hypothetical $100MM long/short book tracked against the S&amp;P 500 since inception.
            Price-only, no real capital — the point is to judge the reasoning over time.
          </p>
          <dl class="mt-7 grid grid-cols-3 gap-6 border-t border-ink pt-4">
            <div>
              <dt class="label-caps">Paper NAV</dt>
              <dd class="figure mt-1.5 text-xl font-medium text-ink">{pct(pf.navReturn)}</dd>
            </div>
            <div>
              <dt class="label-caps">S&amp;P 500</dt>
              <dd class="figure mt-1.5 text-xl font-medium text-ink">{pct(pf.spxReturn)}</dd>
            </div>
            <div>
              <dt class="label-caps">Excess</dt>
              <dd class:list={['figure mt-1.5 text-xl font-medium', pf.excess >= 0 ? 'text-long' : 'text-short']}>
                {pct(pf.excess)}
              </dd>
            </div>
          </dl>
          <a href="/portfolio" class="link mt-7 inline-block font-sans text-sm font-medium">
            Full portfolio &amp; positions
          </a>
        </div>
        <div class="border border-ink bg-card p-5">
          <NavChart history={pf.history} />
        </div>
      </div>
    </div>
  </section>

  <!-- Disclaimer -->
  <section class="mx-auto max-w-6xl px-5 py-10">
    <Disclaimer variant="banner" />
  </section>
</BaseLayout>
