---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import NavChart from '../components/NavChart.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { getPortfolio } from '../lib/portfolio';
import { site } from '../data/site';
import { formatDate, formatPrice, formatPriceWhole, pct } from '../lib/format';

const pf = getPortfolio();

const stats = [
  { label: 'Paper NAV', value: formatPriceWhole(pf.navDollars), sub: pct(pf.navReturn) + ' since inception' },
  { label: 'Total return', value: pct(pf.navReturn), sub: 'price-only, marked to market' },
  { label: 'S&P 500', value: pct(pf.spxReturn), sub: 'same window' },
  {
    label: 'Excess vs S&P (alpha)',
    value: pct(pf.excess),
    sub: pf.excess >= 0 ? 'ahead of benchmark' : 'behind benchmark',
    color: pf.excess >= 0 ? 'text-long' : 'text-short',
  },
];
---

<BaseLayout
  title="Portfolio"
  description="The Starzecki Research paper portfolio — a hypothetical $100MM long/short book, marked to market and benchmarked against the S&P 500."
>
  <section class="mx-auto max-w-5xl px-5 pt-12">
    <PageHeader
      eyebrow="The paper portfolio"
      title="Portfolio"
      intro="A hypothetical $100MM long/short book — marked to market, price-only, and benchmarked against the S&P 500. No real capital is at risk; the point is a transparent, timestamped record of the reasoning."
    />
  </section>

  <!-- Headline stats band -->
  <section class="mx-auto max-w-5xl px-5">
    <dl class="grid grid-cols-2 gap-y-6 border-b border-line py-6 sm:grid-cols-4 sm:divide-x sm:divide-line">
      {
        stats.map((s, i) => (
          <div class:list={['pr-4', i > 0 && 'sm:pl-6']}>
            <dt class="label-caps">{s.label}</dt>
            <dd class:list={['figure mt-2 text-xl font-medium', s.color ?? 'text-ink']}>{s.value}</dd>
            <dd class="mt-1 font-sans text-xs text-muted">{s.sub}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="mx-auto max-w-5xl px-5 py-12">
    <!-- Chart -->
    <div class="border border-ink bg-card p-6">
      <div class="border-b border-line pb-4">
        <h2 class="font-serif text-xl text-ink">NAV vs S&amp;P 500</h2>
        <p class="mt-1 font-sans text-sm text-muted">Both indexed to 100 at inception.</p>
      </div>
      <div class="mt-5">
        <NavChart history={pf.history} />
      </div>
    </div>

    <!-- Positions -->
    <div class="mt-14">
      <div class="flex items-baseline justify-between border-b border-ink pb-3">
        <h2 class="font-serif text-2xl text-ink">Positions</h2>
        {
          site.portfolioSheetUrl ? (
            <a href={site.portfolioSheetUrl} target="_blank" rel="noopener" class="link font-sans text-sm">
              Live tracker (Google Sheets)
            </a>
          ) : (
            <span class="font-sans text-xs text-muted">Live tracker link coming soon</span>
          )
        }
      </div>

      <div class="overflow-x-auto">
        <table class="w-full min-w-[760px] border-collapse text-sm">
          <thead>
            <tr class="text-left">
              <th class="label-caps border-b border-ink px-3 py-3 first:pl-0">Position</th>
              <th class="label-caps border-b border-ink px-3 py-3">Dir.</th>
              <th class="label-caps border-b border-ink px-3 py-3">Sector</th>
              <th class="label-caps border-b border-ink px-3 py-3">Entry</th>
              <th class="label-caps border-b border-ink px-3 py-3 text-right">Entry px</th>
              <th class="label-caps border-b border-ink px-3 py-3 text-right">Current</th>
              <th class="label-caps border-b border-ink px-3 py-3 text-right">Return</th>
              <th class="label-caps border-b border-ink px-3 py-3 text-right">Weight</th>
              <th class="label-caps border-b border-ink px-3 py-3 last:pr-0">Report</th>
            </tr>
          </thead>
          <tbody class="font-sans">
            {
              pf.positions.length === 0 && (
                <tr class="border-b border-line">
                  <td colspan="9" class="px-3 py-10 text-center text-muted">
                    No positions yet. Add your first one in <code class="figure text-xs">src/data/portfolio.json</code> once
                    you publish a report.
                  </td>
                </tr>
              )
            }
            {
              pf.positions.map((p) => (
                <tr class="border-b border-line">
                  <td class="px-3 py-3 first:pl-0">
                    <span class="figure font-semibold text-ink">{p.ticker}</span>
                    <span class="block text-xs text-muted">{p.company}</span>
                  </td>
                  <td class:list={['px-3 py-3 font-medium', p.direction === 'Long' ? 'text-long' : 'text-short']}>
                    {p.direction}
                  </td>
                  <td class="px-3 py-3 text-muted">{p.sector}</td>
                  <td class="figure px-3 py-3 text-xs text-muted">{formatDate(new Date(p.entryDate))}</td>
                  <td class="figure px-3 py-3 text-right">{formatPrice(p.entryPrice)}</td>
                  <td class="figure px-3 py-3 text-right">{formatPrice(p.currentPrice)}</td>
                  <td class:list={['figure px-3 py-3 text-right font-medium', p.returnPct >= 0 ? 'text-long' : 'text-short']}>
                    {pct(p.returnPct)}
                  </td>
                  <td class="figure px-3 py-3 text-right text-muted">{(p.weight * 100).toFixed(1)}%</td>
                  <td class="px-3 py-3 last:pr-0">
                    {p.reportSlug ? (
                      <a href={`/research/${p.reportSlug}`} class="link font-medium">
                        View
                      </a>
                    ) : (
                      <span class="text-muted">—</span>
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-3 font-sans text-xs text-muted">
        Closed and losing positions stay on the record — nothing is deleted. Weights are share of the
        $100MM paper book.
      </p>
    </div>

    <div class="mt-12">
      <Disclaimer variant="banner" />
    </div>
  </section>
</BaseLayout>
