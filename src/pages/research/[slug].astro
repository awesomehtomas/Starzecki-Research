---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RatingBadge from '../../components/RatingBadge.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import { site } from '../../data/site';
import { formatDate, formatPrice, impliedMove, pct } from '../../lib/format';

export async function getStaticPaths() {
  const reports = (await getCollection('reports')).sort(
    (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
  );
  return reports.map((report, i) => ({
    params: { slug: report.id },
    props: {
      report,
      newer: reports[i - 1] ?? null, // toward the top of the list (more recent)
      older: reports[i + 1] ?? null,
    },
  }));
}

interface Props {
  report: CollectionEntry<'reports'>;
  newer: CollectionEntry<'reports'> | null;
  older: CollectionEntry<'reports'> | null;
}

const { report, newer, older } = Astro.props;
const d = report.data;
const move = impliedMove(d.priceAtPublication, d.priceTarget);
const moveColor = move >= 0 ? 'text-long' : 'text-short';
const { Content } = await render(report);
const hasBody = (report.body ?? '').trim().length > 0;

/*
  Tearsheet cells. Rating renders as a stamp; everything else is a mono
  figure. Valuation anchors appear only when the frontmatter provides them.
*/
const cells: { label: string; value?: string; color?: string; stamp?: boolean }[] = [
  { label: 'Rating', stamp: true },
  { label: 'Conviction', value: d.conviction },
  { label: 'Entry', value: formatPrice(d.priceAtPublication) },
  { label: 'Price target', value: formatPrice(d.priceTarget) },
  { label: 'Implied upside', value: pct(move), color: moveColor },
  { label: 'Horizon', value: d.horizon },
];
if (d.evEbitda != null) cells.push({ label: 'EV/EBITDA', value: `${d.evEbitda}×` });
if (d.fcfYield != null) cells.push({ label: 'FCF yield', value: `${d.fcfYield}%` });
---

<BaseLayout title={d.title} description={d.summary} type="article">
  <article class="mx-auto max-w-4xl px-5 py-10 md:py-12">
    <!-- Breadcrumb -->
    <nav class="font-sans text-sm text-muted" aria-label="Breadcrumb">
      <a href="/research" class="hover:text-accent">Research</a>
      <span class="px-1.5" aria-hidden="true">/</span>
      <span class="figure text-ink-soft">{d.ticker}</span>
    </nav>

    <!-- Masthead -->
    <header class="mt-6">
      <p class="label-caps">Equity research</p>
      <h1 class="mt-3 font-serif text-3xl leading-tight text-ink md:text-[2.75rem] md:leading-[1.1]">
        {d.title}
      </h1>
      <p class="mt-4 font-sans text-sm text-muted">
        <span class="figure font-semibold text-ink">{d.ticker}</span>
        <span class="px-1.5" aria-hidden="true">·</span>{d.company}
        <span class="px-1.5" aria-hidden="true">·</span>{d.sector}
      </p>
      <p class="mt-2 font-sans text-sm text-muted">
        By <span class="font-medium text-ink-soft">{site.author}</span>
        <span class="px-1.5" aria-hidden="true">·</span>
        <time datetime={d.publishDate.toISOString()} class="figure">{formatDate(d.publishDate)}</time>
        {
          d.status === 'Closed' && (
            <span class="stamp ml-2 px-1.5 py-[3px] text-[10px] tracking-[0.12em] text-muted">Closed</span>
          )
        }
      </p>

      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">{d.summary}</p>

      <!-- Actions -->
      <div class="mt-7 flex flex-wrap items-center gap-4">
        <a href={d.pdf} download class="btn btn-primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"></path>
          </svg>
          Download PDF
        </a>
        {
          d.modelUrl && (
            <a href={d.modelUrl} target="_blank" rel="noopener" class="btn btn-outline">
              Open the model
            </a>
          )
        }
        <a href={d.pdf} target="_blank" rel="noopener" class="link font-sans text-sm font-medium">
          Open PDF in new tab
        </a>
      </div>
    </header>

    <div class="rule-double mt-8" aria-hidden="true"></div>

    <!-- Tearsheet -->
    <dl
      class="grid border border-t-0 border-ink bg-card sm:grid-cols-2 [&>div]:border-t [&>div]:border-line [&>div:first-child]:border-t-0 sm:[&>div:nth-child(2)]:border-t-0 sm:[&>div:nth-child(odd)]:border-r sm:[&>div:nth-child(odd)]:border-r-line"
    >
      {
        cells.map((cell) => (
          <div class="flex items-center justify-between gap-4 px-4 py-3">
            <dt class="label-caps">{cell.label}</dt>
            <dd class:list={['figure text-sm font-medium', cell.color ?? 'text-ink']}>
              {cell.stamp ? <RatingBadge rating={d.rating} size="sm" /> : cell.value}
            </dd>
          </div>
        ))
      }
    </dl>

    <!-- Optional written notes -->
    {
      hasBody && (
        <section class="mt-12">
          <h2 class="border-b border-ink pb-3 font-serif text-2xl text-ink">Analyst notes</h2>
          <div class="rich-text mt-6">
            <Content />
          </div>
        </section>
      )
    }

    <!-- Embedded PDF -->
    <section class="mt-12">
      <div class="border border-ink">
        <div class="flex items-center justify-between border-b border-ink bg-paper-deep px-4 py-2.5">
          <span class="label-caps">
            <span class="figure">{d.ticker}</span> · Full report
          </span>
          <a href={d.pdf} download class="link font-sans text-xs font-semibold">
            Download PDF
          </a>
        </div>
        <iframe
          src={`${d.pdf}#view=FitH`}
          title={`${d.title} — PDF`}
          class="h-[80vh] w-full bg-paper-deep"
          loading="lazy"></iframe>
      </div>
      <p class="mt-2 font-sans text-xs text-muted">
        PDF not displaying? <a href={d.pdf} target="_blank" rel="noopener" class="link">Open it in a new tab</a> or download it above.
      </p>
    </section>

    <!-- Prev / next -->
    <nav class="mt-12 grid gap-x-8 border-t border-ink sm:grid-cols-2" aria-label="More reports">
      {
        older ? (
          <a href={`/research/${older.id}`} class="group border-b border-line py-4">
            <span class="label-caps">Older report</span>
            <span class="mt-1 block font-serif text-lg text-ink transition-colors group-hover:text-accent">
              <span class="figure text-sm font-semibold">{older.data.ticker}</span> · {older.data.company}
            </span>
          </a>
        ) : (
          <span class="hidden sm:block" />
        )
      }
      {
        newer && (
          <a href={`/research/${newer.id}`} class="group border-b border-line py-4 sm:text-right">
            <span class="label-caps">Newer report</span>
            <span class="mt-1 block font-serif text-lg text-ink transition-colors group-hover:text-accent">
              <span class="figure text-sm font-semibold">{newer.data.ticker}</span> · {newer.data.company}
            </span>
          </a>
        )
      }
    </nav>

    <div class="mt-12">
      <Disclaimer variant="full" />
    </div>
  </article>
</BaseLayout>
