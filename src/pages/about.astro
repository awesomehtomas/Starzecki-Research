---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

// Timeline — edit freely as your story grows.
const timeline = [
  { when: 'Undergraduate', what: 'B.B.A., Hofstra University · December 2024' },
  { when: 'Graduate', what: 'M.S. in Investment Analysis, Hofstra University · December 2025' },
  { when: 'In progress', what: 'CFA Level I candidate · Exam November 2026' },
  { when: 'Ongoing', what: 'Financial modeling — DCF, comps, three-statement, LBO' },
  { when: 'Now', what: 'Launching Starzecki Research' },
];
---

<BaseLayout
  title="About"
  description="Thomas Starzecki — finance graduate, CFA Level I candidate, and the analyst behind Starzecki Research. My path in finance and how I approach equity research."
>
  <section class="mx-auto max-w-3xl px-5 py-12">
    <header class="border-b border-ink pb-7">
      <p class="label-caps">My finance journey</p>
      <h1 class="mt-3 font-serif text-3xl text-ink md:text-4xl">About</h1>
    </header>

    <div class="mt-8 space-y-5 text-lg leading-relaxed text-ink-soft">
      <p>
        My name is {site.author}. I graduated in December 2025 with an M.S. in Investment Analysis
        from Hofstra University, and I’m a CFA Level I candidate sitting for the exam in November
        2026. Starzecki Research exists to demonstrate my work in equity research — the field my
        education is built around. Every report is written from the perspective of a buy-side
        analyst.
      </p>
      <p>
        Most early-career analysis never leaves a laptop. I’d rather put mine in the open and let it
        be judged over time — not as a line on a résumé, but as a public, growing body of work. Every
        report is timestamped at publication, every position is benchmarked against the S&amp;P 500,
        and the calls that don’t work stay up.
      </p>
    </div>

    <!-- Timeline -->
    <h2 class="mt-14 border-b border-ink pb-3 font-serif text-2xl text-ink">The journey so far</h2>
    <ol>
      {
        timeline.map((t) => (
          <li class="grid gap-x-8 gap-y-1 border-b border-line py-4 sm:grid-cols-[8.5rem_1fr] sm:items-baseline">
            <p class="label-caps">{t.when}</p>
            <p class="font-serif text-lg text-ink">{t.what}</p>
          </li>
        ))
      }
    </ol>

    <!-- Looking for -->
    <h2 class="mt-14 border-b border-ink pb-3 font-serif text-2xl text-ink">What I’m looking for</h2>
    <p class="mt-5 leading-relaxed text-ink-soft">
      I’m early in my career and pointed squarely at equity research, investment management, and
      investment banking. This site is intended to show what a résumé cannot: thought process,
      consistency, and a track record. I welcome anyone with questions to reach out.
    </p>

    <!-- Contact -->
    <div class="mt-14 border border-ink bg-card p-6">
      <h2 class="font-serif text-xl text-ink">Get in touch</h2>
      <p class="mt-2 font-sans text-sm text-muted">I’d welcome a conversation — feedback, ideas, or opportunities.</p>
      <div class="mt-5 flex flex-wrap gap-4">
        <a href={site.linkedin} target="_blank" rel="me noopener" class="btn btn-primary">
          Connect on LinkedIn
        </a>
        <a href={`mailto:${site.email}`} class="btn btn-outline normal-case tracking-normal">
          {site.email}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
