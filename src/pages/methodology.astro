---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Disclaimer from '../components/Disclaimer.astro';

const houseFormat = [
  ['Recommendation & Executive Summary', 'The rating (Buy/Neutral/Sell), price target, implied upside and time horizon — and the thesis in a paragraph.'],
  ['Company Overview', 'How the company operates and makes money.'],
  ['Industry & Competitive Positioning', 'The market structure and where the company stands within it.'],
  ['Investment Thesis & Variant View', 'Where my view differs from consensus or the price — with the reasons.'],
  ['Catalysts', 'The identifiable catalysts for the thesis to play out, with dates.'],
  ['Valuation', 'A DCF reconciled against comparable companies, with the gap between them explained.'],
  ['Financial Model Summary', 'Key drivers and outputs from the underlying three-statement model.'],
  ['Sensitivity & Scenario Analysis', 'How the target moves under bear / base / bull assumptions.'],
  ['Risks, Mitigants & Disconfirmers', 'The threats to the thesis, their mitigants, and the disconfirming evidence I’m watching for.'],
  ['Monitoring & Review', 'What I track after publication, the triggers that would change the rating, and a scheduled review date.'],
  ['Appendix: Financial Statements', 'The summary income statement, balance sheet and cash flow behind the call.'],
  ['Sources & Disclosures', 'Primary filings, data, and the trail behind every number.'],
];
---

<BaseLayout
  title="Methodology"
  description="How Starzecki Research works — the 12-section report format, the financial model behind every call, and why calls that go wrong stay published."
>
  <section class="mx-auto max-w-3xl px-5 py-12">
    <PageHeader
      eyebrow="How the work is made"
      title="Methodology"
      intro="The value of research is in the reasoning and the record. This page explains exactly how both are produced here so you can judge the work on its merits."
    />

    <!-- Report format -->
    <h2 class="mt-12 font-serif text-2xl text-ink">Anatomy of a report</h2>
    <p class="mt-3 leading-relaxed text-ink-soft">
      Every report follows the same 12 sections. Consistency makes the work easier to read and harder
      to fudge — the same questions get answered every time.
    </p>
    <ol class="mt-7 border-t border-ink">
      {
        houseFormat.map(([title, desc], i) => (
          <li class="grid grid-cols-[2.75rem_1fr] gap-x-4 border-b border-line py-4">
            <span class="figure pt-0.5 text-sm text-muted">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <p class="font-serif text-lg text-ink">{title}</p>
              <p class="mt-0.5 font-sans text-sm leading-relaxed text-muted">{desc}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <!-- The model -->
    <h2 class="mt-12 font-serif text-2xl text-ink">The model behind every report</h2>
    <div class="mt-3 space-y-4 leading-relaxed text-ink-soft">
      <p>
        Every report is built on a full working model — a
        <strong class="text-ink">three-statement build</strong> feeding a
        <strong class="text-ink">DCF</strong>, cross-checked against comparable companies and run
        through bear / base / bull scenarios. Nothing in the write-up is asserted that the model can’t
        support.
      </p>
      <p>
        Every number the write-up relies on appears in a numbered exhibit captured directly from the
        model — estimates, the DCF build and bridge, comps, scenarios and sensitivities — so you can
        see exactly where a price target comes from.
      </p>
    </div>

    <!-- Losers stay -->
    <h2 class="mt-12 font-serif text-2xl text-ink">Losers stay published</h2>
    <p class="mt-3 leading-relaxed text-ink-soft">
      Nothing is deleted. Calls that go wrong stay on the site with their original timestamp, price,
      and target. A track record only means something if it includes the misses — so this one does,
      on purpose.
    </p>

    <div class="mt-12">
      <Disclaimer variant="full" />
    </div>
  </section>
</BaseLayout>
