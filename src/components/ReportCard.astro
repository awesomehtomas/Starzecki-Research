---
import type { CollectionEntry } from 'astro:content';
import RatingBadge from './RatingBadge.astro';
import { formatDate, formatPrice, impliedMove, pct } from '../lib/format';

interface Props {
  report: CollectionEntry<'reports'>;
}
const { report } = Astro.props;
const d = report.data;
const move = impliedMove(d.priceAtPublication, d.priceTarget);
const moveColor = move >= 0 ? 'text-long' : 'text-short';
---

<a
  href={`/research/${report.id}`}
  class="group flex h-full flex-col rounded-lg border border-line bg-card p-5 transition-all hover:-translate-y-0.5 hover:border-accent/50 hover:shadow-[0_8px_30px_-12px_rgba(14,42,59,0.25)]"
>
  <div class="flex items-center justify-between gap-2">
    <div class="flex items-center gap-2">
      <RatingBadge rating={d.rating} size="sm" />
      {
        d.status === 'Closed' && (
          <span class="rounded-full border border-line px-2 py-0.5 text-[11px] font-medium uppercase tracking-wider text-muted">
            Closed
          </span>
        )
      }
    </div>
    <span class="text-[11px] font-medium uppercase tracking-wider text-muted">{d.sector}</span>
  </div>

  <h3 class="mt-3 font-serif text-xl text-ink">
    <span class="font-semibold">{d.ticker}</span>
    <span class="text-muted"> · {d.company}</span>
  </h3>

  <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-ink-soft">{d.summary}</p>

  <div class="mt-auto flex items-center justify-between gap-2 border-t border-line pt-3 text-xs text-muted">
    <time datetime={d.publishDate.toISOString()}>{formatDate(d.publishDate)}</time>
    <span>
      Target {formatPrice(d.priceTarget)}
      <span class={`ml-1 font-semibold ${moveColor}`}>{pct(move)}</span>
    </span>
  </div>
</a>
