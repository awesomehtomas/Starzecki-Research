---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="mt-24">
  <div class="rule-double" aria-hidden="true"></div>
  <div class="mx-auto max-w-6xl px-5 py-12">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <div class="flex items-center gap-2.5">
          <span
            class="grid h-7 w-7 place-items-center bg-accent font-serif text-xs font-semibold text-paper"
            aria-hidden="true">SR</span>
          <span class="font-serif text-lg font-semibold tracking-tight text-ink">Starzecki Research</span>
        </div>
        <p class="mt-3 max-w-xs font-sans text-sm leading-relaxed text-muted">
          {site.tagline}
        </p>
      </div>

      <div>
        <h2 class="label-caps">Site</h2>
        <ul class="mt-4 space-y-2.5 font-sans text-sm">
          {
            site.nav.map((item) => (
              <li>
                <a href={item.href} class="text-ink-soft hover:text-accent">{item.label}</a>
              </li>
            ))
          }
          <li><a href="/disclaimer" class="text-ink-soft hover:text-accent">Disclaimer</a></li>
          <li><a href="/rss.xml" class="text-ink-soft hover:text-accent">RSS feed</a></li>
        </ul>
      </div>

      <div>
        <h2 class="label-caps">Contact</h2>
        <ul class="mt-4 space-y-2.5 font-sans text-sm">
          <li>
            <a href={site.linkedin} class="text-ink-soft hover:text-accent" rel="me noopener" target="_blank">LinkedIn</a>
          </li>
          {
            site.twitterUrl && (
              <li>
                <a href={site.twitterUrl} class="text-ink-soft hover:text-accent" rel="me noopener" target="_blank">X / Twitter</a>
              </li>
            )
          }
          <li>
            <a href={`mailto:${site.email}`} class="text-ink-soft hover:text-accent">{site.email}</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-line pt-6">
      <p class="font-sans text-xs leading-relaxed text-muted">
        {site.notAdvice}{' '}
        <a href="/disclaimer" class="link">Read the full disclaimer.</a>
      </p>
      <p class="mt-2 font-sans text-xs text-muted">© {year} {site.author}. All views are personal and for educational purposes only.</p>
    </div>
  </div>
</footer>
