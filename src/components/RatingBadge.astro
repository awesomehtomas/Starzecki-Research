---
interface Props {
  rating: 'Buy' | 'Neutral' | 'Sell';
  size?: 'sm' | 'md';
}
const { rating, size = 'md' } = Astro.props;

// Square-cornered "stamp" in the rating's own semantic color (see DESIGN.md).
// Full literal class strings so Tailwind's scanner includes them in the build.
const styles: Record<Props['rating'], string> = {
  Buy: 'text-long',
  Neutral: 'text-hold',
  Sell: 'text-short',
};
const pad =
  size === 'sm'
    ? 'px-1.5 py-[3px] text-[10px] tracking-[0.12em]'
    : 'px-2 py-1 text-[11px] tracking-[0.12em]';
---

<span class:list={['stamp', pad, styles[rating]]}>
  {rating}
</span>
