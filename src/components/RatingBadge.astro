---
interface Props {
  rating: 'Long' | 'Short' | 'Hold';
  size?: 'sm' | 'md';
}
const { rating, size = 'md' } = Astro.props;

// Full literal class strings so Tailwind's scanner includes them in the build.
const styles: Record<Props['rating'], string> = {
  Long: 'bg-long-bg text-long',
  Short: 'bg-short-bg text-short',
  Hold: 'bg-hold-bg text-hold',
};
const pad = size === 'sm' ? 'px-2 py-0.5 text-[11px]' : 'px-2.5 py-1 text-xs';
---

<span
  class:list={[
    'inline-flex items-center rounded-full font-semibold uppercase tracking-wider',
    pad,
    styles[rating],
  ]}
>
  {rating}
</span>
