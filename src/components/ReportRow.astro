---
import type { CollectionEntry } from 'astro:content';
import RatingBadge from './RatingBadge.astro';
import { formatDate, formatPrice, impliedMove, pct } from '../lib/format';

/*
  A report as a ruled index row — like a line in a journal's table of
  contents, not a card (see DESIGN.md §4). Used on /research and the homepage.
*/
interface Props {
  report: CollectionEntry<'reports'>;
}
const { report } = Astro.props;
const d = report.data;
const move = impliedMove(d.priceAtPublication, d.priceTarget);
const moveColor = move >= 0 ? 'text-long' : 'text-short';
---

<a
  href={`/research/${report.id}`}
  class="group grid gap-x-8 gap-y-2 border-b border-line py-5 transition-colors sm:grid-cols-[8.5rem_minmax(0,1fr)_auto]"
>
  <!-- Dateline + stamp -->
  <div class="flex items-center gap-3 sm:flex-col sm:items-start sm:gap-2">
    <time datetime={d.publishDate.toISOString()} class="figure text-xs text-muted">
      {formatDate(d.publishDate)}
    </time>
    <div class="flex items-center gap-1.5">
      <RatingBadge rating={d.rating} size="sm" />
      {
        d.status === 'Closed' && (
          <span class="stamp px-1.5 py-[3px] text-[10px] tracking-[0.12em] text-muted">Closed</span>
        )
      }
    </div>
  </div>

  <!-- Title block -->
  <div class="min-w-0">
    <p class="font-sans text-xs text-muted">
      <span class="figure font-semibold text-ink">{d.ticker}</span>
      <span class="px-1" aria-hidden="true">·</span>{d.company}
      <span class="px-1" aria-hidden="true">·</span>{d.sector}
    </p>
    <h3 class="mt-1 font-serif text-xl leading-snug text-ink transition-colors group-hover:text-accent">
      {d.title}
    </h3>
    <p class="mt-1.5 line-clamp-2 max-w-xl text-[0.9375rem] leading-relaxed text-ink-soft">
      {d.summary}
    </p>
  </div>

  <!-- Figures -->
  <dl class="flex gap-6 sm:flex-col sm:gap-2 sm:text-right">
    <div>
      <dt class="label-caps">Target</dt>
      <dd class="figure mt-0.5 text-sm font-medium text-ink">{formatPrice(d.priceTarget)}</dd>
    </div>
    <div>
      <dt class="label-caps">Upside</dt>
      <dd class:list={['figure mt-0.5 text-sm font-medium', moveColor]}>{pct(move)}</dd>
    </div>
  </dl>
</a>
