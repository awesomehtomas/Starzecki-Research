---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<header class="border-b border-ink pb-7">
  {eyebrow && <p class="label-caps">{eyebrow}</p>}
  <h1 class="mt-3 font-serif text-3xl text-ink md:text-4xl">{title}</h1>
  {intro && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">{intro}</p>}
</header>
