---
import { site } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/') || path === href;
---

<header class="sticky top-0 z-50 bg-paper">
  <div class="mx-auto max-w-6xl px-5">
    <div class="flex h-16 items-center justify-between md:h-[4.5rem]">
      <!-- Wordmark -->
      <a href="/" class="flex items-center gap-3" aria-label={site.name + ' home'}>
        <span
          class="grid h-9 w-9 place-items-center bg-accent font-serif text-base font-semibold text-paper"
          aria-hidden="true">SR</span>
        <span class="flex flex-col">
          <span class="font-serif text-xl font-semibold leading-none tracking-tight text-ink">
            Starzecki Research
          </span>
          <span class="label-caps mt-1.5 hidden leading-none sm:block">Independent equity research</span>
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden items-center gap-7 md:flex" aria-label="Primary">
        {
          site.nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'font-sans text-sm transition-colors',
                isActive(item.href)
                  ? 'font-semibold text-ink underline decoration-accent decoration-2 underline-offset-8'
                  : 'font-medium text-ink-soft hover:text-accent',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <!-- Mobile toggle -->
      <button
        id="nav-toggle"
        class="inline-flex items-center justify-center p-2 text-ink md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Mobile nav -->
    <nav
      id="mobile-nav"
      class="hidden border-t border-line pb-4 md:hidden"
      aria-label="Primary mobile"
    >
      <ul class="flex flex-col">
        {
          site.nav.map((item) => (
            <li class="border-b border-line">
              <a
                href={item.href}
                class:list={[
                  'block px-1 py-3 font-sans text-sm',
                  isActive(item.href) ? 'font-semibold text-accent' : 'font-medium text-ink-soft',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <!-- Masthead double rule -->
  <div class="rule-double" aria-hidden="true"></div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
