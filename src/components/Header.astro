---
import { site } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/') || path === href;
---

<header class="border-b border-line bg-paper/90 backdrop-blur sticky top-0 z-50">
  <div class="mx-auto max-w-6xl px-5">
    <div class="flex h-16 items-center justify-between">
      <!-- Wordmark -->
      <a href="/" class="flex items-center gap-3 group" aria-label={site.name + ' home'}>
        <span
          class="grid h-9 w-9 place-items-center rounded-sm bg-ink text-paper font-serif text-sm font-semibold tracking-tight"
          aria-hidden="true">SR</span>
        <span class="font-serif text-lg font-semibold tracking-tight text-ink">
          Starzecki <span class="text-accent">Research</span>
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-7" aria-label="Primary">
        {
          site.nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'text-sm font-medium transition-colors hover:text-accent',
                isActive(item.href) ? 'text-accent' : 'text-ink-soft',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <!-- Mobile toggle -->
      <button
        id="nav-toggle"
        class="md:hidden inline-flex items-center justify-center rounded-sm p-2 text-ink"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Mobile nav -->
    <nav
      id="mobile-nav"
      class="md:hidden hidden pb-4"
      aria-label="Primary mobile"
    >
      <ul class="flex flex-col gap-1">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'block rounded-sm px-3 py-2 text-sm font-medium',
                  isActive(item.href) ? 'bg-paper-deep text-accent' : 'text-ink-soft',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
