---
import { site } from '../data/site';

interface Props {
  variant?: 'banner' | 'full';
}
const { variant = 'banner' } = Astro.props;
---

{
  variant === 'banner' ? (
    <p class="border-y border-line py-3 font-sans text-xs leading-relaxed text-muted">
      <span class="font-semibold text-ink">Educational use only.</span> {site.notAdvice}{' '}
      <a href="/disclaimer" class="link">
        Full disclaimer
      </a>
      .
    </p>
  ) : (
    <div class="border-y border-line py-4 font-sans text-sm leading-relaxed text-muted">
      <p>
        <span class="font-semibold text-ink">Not investment advice.</span> Starzecki Research is an
        independent, educational project. Nothing here is a recommendation to buy or sell any
        security. The portfolio is hypothetical and tracks no real capital. Prices and figures may
        be delayed or in error. Do your own research and consult a licensed professional before
        investing.
      </p>
    </div>
  )
}
