---
import { site } from '../data/site';

interface Props {
  variant?: 'banner' | 'full';
}
const { variant = 'banner' } = Astro.props;
---

{
  variant === 'banner' ? (
    <p class="border-y border-line py-3 font-sans text-xs leading-relaxed text-muted">
      {site.notAdvice}{' '}
      <a href="/disclaimer" class="link">
        Full disclaimer
      </a>
      .
    </p>
  ) : (
    <div class="border-y border-line py-4 font-sans text-sm leading-relaxed text-muted">
      <p>
        <span class="font-semibold text-ink">{site.notAdvice}</span> Everything here is produced
        for educational and demonstration purposes only. Nothing is a recommendation or solicitation
        to buy or sell any security, and no real capital is managed. Prices, figures, and price
        targets may be delayed, approximate, or in error.
      </p>
    </div>
  )
}
